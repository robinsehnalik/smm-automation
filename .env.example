# ==============================================================================
# Social Media Management (SMM) Automation — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Keys & Authentication Secrets
# ------------------------------------------------------------------------------
# OpenAI API Key (requires access to LLM_MODEL_POSTS and LLM_MODEL_CLASSIFY)
OPENAI_API_KEY=sk-proj-...your-openai-api-key

# Ayrshare API Key (from app.ayrshare.com)
AYRSHARE_API_KEY=your-ayrshare-api-key

# ManyChat API Token (from ManyChat Settings > API)
MANYCHAT_API_TOKEN=your-manychat-api-token

# Content Calendar Token (Airtable Personal Access Token with data.records read/write)
AIRTABLE_TOKEN=pat...your-airtable-personal-access-token
AIRTABLE_BASE_ID=app...your-airtable-base-id
AIRTABLE_TABLE_NAME=ContentCalendar

# Supabase Secrets (Never expose service role key to clients)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-supabase-service-role-key

# Static Webhook Secret for Inbound ManyChat Webhooks (Header: X-Webhook-Secret)
# Generate with: openssl rand -hex 24
MANYCHAT_WEBHOOK_SECRET=replace_with_a_secure_random_static_secret

# Alerting & Incident Notification (Resend API)
RESEND_API_KEY=re_...your-resend-api-key
SYSTEM_SENDER_EMAIL=alerts@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=engineering-alerts@yourdomain.com

# Cryptographic Salt for Subscriber ID Hashing in bot_events (Never change once set)
# Generate with: openssl rand -hex 16
HASH_SALT=replace_with_a_secure_random_salt

# ------------------------------------------------------------------------------
# 2. Model Selection & Runtime Flags
# ------------------------------------------------------------------------------
# Model used for creative social variant generation (SMM-POST-01)
LLM_MODEL_POSTS=gpt-4o

# Model used for fast, structured intent classification (SMM-MSG-01)
LLM_MODEL_CLASSIFY=gpt-4o-mini

# Global Kill Switch for Inbound DM Bot (true = active, false = muted with needs_human tag)
BOT_ENABLED=true

# Shadow Mode (true = predict & log to bot_events without sending actual DMs)
# MUST remain true for initial 7-day observation period before live rollout
SHADOW_MODE=true

# ------------------------------------------------------------------------------
# 3. Rate Limits, Timing & Safety Thresholds
# ------------------------------------------------------------------------------
# Maximum automated replies allowed per subscriber per hour
MAX_BOT_REPLIES_PER_HOUR=5

# Global maximum daily LLM classification calls before auto-escalating
DAILY_LLM_CALL_CAP=1000

# Hours to mute automated bot after human escalation takes place
HANDOFF_PAUSE_HOURS=24

# Minimum lead time in minutes required between scheduling time and publish time
MIN_SCHEDULE_LEAD_MINUTES=10

# Mandatory automated assistant disclosure footer appended to all outbound DMs
AUTO_REPLY_FOOTER="—\n🤖 Automated Assistant | Reply 'agent' to speak with our team."
