{
  "name": "SMM-ERR Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "61914c20-4c07-4cc3-8691-ecd699e22b59",
      "name": "SMM Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const err = $json.execution?.error || {};\nconst workflow = $json.workflow || {};\n\nreturn [{\n  json: {\n    workflowName: workflow.name,\n    nodeName: err.node?.name || 'Unknown Node',\n    message: err.message || 'Unknown runtime error',\n    executionId: $json.execution?.id\n  }\n}];"
      },
      "id": "fbd48ff6-27d1-4796-98d2-4c48ddead472",
      "name": "Format Error Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/workflow_log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  workflow_name: $json.workflowName,\n  node_name: $json.nodeName,\n  error_message: $json.message,\n  execution_id: $json.executionId\n}) }}"
      },
      "id": "1ede43a4-308d-498b-9819-d37feb1f386b",
      "name": "Log Error to DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.RESEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  from: $env.SYSTEM_SENDER_EMAIL || \"alerts@yourdomain.com\",\n  to: [$env.ADMIN_NOTIFICATION_EMAIL],\n  subject: \"[ALERT] SMM Workflow Failure: \" + $json.workflowName,\n  html: `<p>Workflow <strong>${$json.workflowName}</strong> failed at node <strong>${$json.nodeName}</strong>:</p>\n<pre>${$json.message}</pre>`\n}) }}"
      },
      "id": "9c56fd7c-65e8-4573-8fa5-751ea703b787",
      "name": "Send SMM Error Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        820,
        300
      ]
    }
  ],
  "connections": {
    "SMM Error Trigger": {
      "main": [
        [
          {
            "node": "Format Error Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Error Record": {
      "main": [
        [
          {
            "node": "Log Error to DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Error to DB": {
      "main": [
        [
          {
            "node": "Send SMM Error Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "6e7f889d-6929-4f90-91d5-0632bf7a6da5",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "automation-suite"
  },
  "id": "cdce2308",
  "tags": []
}