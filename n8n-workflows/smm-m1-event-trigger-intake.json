{
  "name": "SMM-M1 Event Trigger Intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smm/events",
        "responseMode": "responseNode"
      },
      "id": "f220618b-bad2-433b-8e5d-a463e810a01d",
      "name": "Platform Webhook Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $json.body || {};\nconst platform = body.platform || 'meta';\nconst eventId = body.entry?.[0]?.id || body.event_id || ('evt_' + Date.now());\nconst senderId = body.sender?.id || body.user_id || 'user_anon';\nconst text = body.message?.text || body.comment_text || '';\n\nreturn [{\n  json: {\n    platform,\n    externalEventId: eventId,\n    senderId,\n    text,\n    eventType: body.type || 'comment'\n  }\n}];"
      },
      "id": "90f8e8a3-211f-41d4-94c8-42e1f39f8e74",
      "name": "Verify & Dedupe Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/messages",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "external_event_id",
              "value": "eq.{{ $json.externalEventId }}"
            },
            {
              "name": "select",
              "value": "id"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        }
      },
      "id": "a2609f6a-c1eb-42af-a00b-c0d08a94d14e",
      "name": "Check Duplicate Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ Array.isArray($json) ? $json.length > 0 : ($json.id ? true : false) }}",
              "value2": true
            }
          ]
        }
      },
      "id": "f5e0545b-9026-4486-81a0-0b66976950e0",
      "name": "Is Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "return [{ json: { skipped: true } }];"
      },
      "id": "3615354c-58af-4c89-932d-a2374538f6e9",
      "name": "Skip Duplicate Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  direction: 'inbound',\n  event_type: $('Verify & Dedupe Event').first().json.eventType,\n  body: $('Verify & Dedupe Event').first().json.text,\n  external_event_id: $('Verify & Dedupe Event').first().json.externalEventId\n}) }}"
      },
      "id": "fcc29358-4e81-4bc2-989f-2bb561e50406",
      "name": "Insert Inbound Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1060,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_N8N_INSTANCE }}/webhook/smm/response-builder",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messageId: $json[0].id }) }}"
      },
      "id": "9d83d70f-260f-436c-bd54-b039c956b480",
      "name": "Trigger SMM-M2 Response Builder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1300,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, handled: true }) }}"
      },
      "id": "0e6f25e7-ef11-4347-9947-036e334ded6b",
      "name": "Respond Webhook Handled",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1540,
        300
      ]
    }
  ],
