{
  "name": "SMM-M1 Event Trigger Intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smm/events",
        "responseMode": "responseNode"
      },
      "id": "b3c52719-643c-4636-ae15-e7e104e59a06",
      "name": "3rd-Party Messenger Webhook Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $json.body || $json;\n\n// Standardize payload across 3rd-party messaging platforms (ManyChat, Gorgias, Front, or social webhooks)\nconst platform = body.channel || body.platform || 'instagram';\nconst eventId = body.event_id || body.message_id || body.id || ('evt_' + Date.now());\nconst senderId = body.subscriber?.id || body.subscriber_id || body.sender_id || body.user_id || 'subscriber_anon';\nconst senderName = body.subscriber?.name || body.sender_name || body.user_name || 'Customer';\nconst text = body.message?.text || body.text || body.content || body.comment_text || '';\n\nif (!text) {\n  return [{ json: { skipped: true, reason: 'Empty message text' } }];\n}\n\nreturn [{\n  json: {\n    platform,\n    externalEventId: eventId.toString(),\n    senderId: senderId.toString(),\n    senderName,\n    text,\n    eventType: body.event_type || 'dm'\n  }\n}];"
      },
      "id": "77509ec3-48a8-4061-a77f-311af27ebd95",
      "name": "Normalize Messenger Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/messages",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "external_event_id",
              "value": "eq.{{ $json.externalEventId }}"
            },
            {
              "name": "select",
              "value": "id"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        }
      },
      "id": "d250cc33-c5ba-4321-b2bb-682c19391674",
      "name": "Check Duplicate Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ Array.isArray($json) ? $json.length > 0 : ($json.id ? true : false) }}",
              "value2": true
            }
          ]
        }
      },
      "id": "11669edd-e220-4546-a4a0-a7715b1e2a9c",
      "name": "Is Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "return [{ json: { skipped: true, message: 'Duplicate event skipped' } }];"
      },
      "id": "f57cf172-2921-478b-b2cd-b9815b406458",
      "name": "Skip Duplicate Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  direction: 'inbound',\n  event_type: $('Normalize Messenger Event').first().json.eventType,\n  body: $('Normalize Messenger Event').first().json.text,\n  external_event_id: $('Normalize Messenger Event').first().json.externalEventId\n}) }}"
      },
      "id": "a21e2c12-8fdf-4d1c-9793-4a12f9cfbe66",
      "name": "Insert Inbound Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1060,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_N8N_INSTANCE }}/webhook/smm/response-builder",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messageId: $json[0].id, senderId: $('Normalize Messenger Event').first().json.senderId }) }}"
      },
      "id": "cd1aee8d-1ea1-45e3-b44e-add23bd428f1",
      "name": "Trigger SMM-M2 Response Builder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1300,
        420
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, handled: true }) }}"
      },
      "id": "abf526a1-9206-47dd-abf2-736cc29e4d10",
      "name": "Respond Webhook Handled",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1540,
        300
      ]
    }
  ],
