{
  "name": "SMM-M2 LLM Response Builder",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smm/response-builder",
        "responseMode": "onReceived"
      },
      "id": "c32a193b-30a9-4d60-881d-c61cf279854d",
      "name": "Response Builder Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/messages",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "eq.{{ $json.body.messageId }}"
            },
            {
              "name": "select",
              "value": "*"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        }
      },
      "id": "b153f74a-fbb0-4c66-b997-7cc85485aca0",
      "name": "Fetch Message & Brand Voice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"gpt-4o\",\n  response_format: { type: \"json_object\" },\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a brand social assistant. Assess incoming message from the 3rd-party messaging platform for sentiment, complaints, or custom pricing. Ground answers strictly in company facts. Return JSON: { \\\"reply\\\": string, \\\"confidence\\\": number, \\\"needs_human\\\": boolean, \\\"sentiment\\\": \\\"positive|neutral|negative|spam\\\" }\"\n    },\n    { role: \"user\", content: $json[0].body }\n  ]\n}) }}"
      },
      "id": "a4e88f6f-cfca-4333-9f5c-04409b8895df",
      "name": "LLM Response & Risk Assessment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const res = JSON.parse($json.choices[0].message.content);\nconst msgId = $('Fetch Message & Brand Voice').first().json[0].id;\nconst senderId = $('Response Builder Trigger').first().json.body.senderId || 'subscriber_anon';\n\nconst canAutoReply = res.confidence >= 0.85 && !res.needs_human && res.sentiment !== 'negative';\n\nreturn [{\n  json: {\n    messageId: msgId,\n    senderId: senderId,\n    reply: res.reply,\n    canAutoReply,\n    needsHuman: !canAutoReply,\n    confidence: res.confidence\n  }\n}];"
      },
      "id": "ae47de8a-2c27-4c02-a795-1face4a76217",
      "name": "Evaluate Decision Policy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.canAutoReply }}",
              "value2": true
            }
          ]
        }
      },
      "id": "907bdab8-bcd9-4ed4-8bb3-16b3058dc4d8",
      "name": "Can Auto Reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_N8N_INSTANCE }}/webhook/smm/dispatch",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "aa55fc61-99dd-4c3b-bbfd-c2d42f3cb6a1",
      "name": "Trigger SMM-M3 Dispatch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1300,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_N8N_INSTANCE }}/webhook/smm/escalate",
