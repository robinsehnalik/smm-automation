{
  "name": "SMM-M3 Messenger Dispatch",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smm/dispatch",
        "responseMode": "responseNode"
      },
      "id": "c1ea6778-5674-487f-b923-f69c05a5c2b7",
      "name": "Dispatch Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $json.body || {};\nreturn [{\n  json: {\n    messageId: body.messageId,\n    senderId: body.senderId || 'subscriber_anon',\n    reply: body.reply,\n    allowed: true\n  }\n}];"
      },
      "id": "13124d74-6ede-4010-a75d-2528983c60bb",
      "name": "Verify Rate Limit Caps",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_MESSENGER_API || 'https://api.manychat.com/fb/sending/sendContent' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.MESSENGER_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  subscriber_id: $json.senderId,\n  data: {\n    version: \"v2\",\n    content: {\n      messages: [\n        { type: \"text\", text: $json.reply }\n      ]\n    }\n  }\n}) }}"
      },
      "id": "f0eb4b86-47df-49e8-bc06-2225c6cc0f2d",
      "name": "Send Reply via 3rd-Party Messenger API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  direction: 'outbound',\n  body: $('Verify Rate Limit Caps').first().json.reply,\n  auto_sent: true\n}) }}"
      },
      "id": "0f513d84-7821-4fff-9f86-37c7a37aab62",
      "name": "Update Message Sent in DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: \"Reply dispatched via messenger platform\" }) }}"
      },
      "id": "bff317d2-79a8-472e-b8b8-8770228077cd",
      "name": "Respond Dispatch Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1060,
        300
      ]
    }
  ],
  "connections": {
    "Dispatch Trigger": {
      "main": [
