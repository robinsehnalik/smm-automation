      ]
    },
    {
      "parameters": {
        "url": "https://api.manychat.com/fb/subscriber/setCustomField",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.MANYCHAT_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"subscriber_id\": $json.subscriber_id,\n  \"field_name\": \"needs_human\",\n  \"field_value\": \"true\"\n}"
      },
      "id": "a58727a7-47db-45a5-81ee-df675f4e2818",
      "name": "ManyChat: Set Live Chat Open",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2120,
        520
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/social_conversations",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"subscriber_id\": $json.subscriber_id,\n  \"platform\": $json.channel,\n  \"is_human_takeover\": !$json.is_safe_to_reply,\n  \"bot_reply_count\": $json.is_safe_to_reply ? ($json.bot_reply_count + 1) : $json.bot_reply_count,\n  \"last_interaction_at\": new Date().toISOString()\n}"
      },
      "id": "c1d845da-f868-43aa-86fa-5e970da75b82",
      "name": "Supabase: Upsert Conversation & Log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2360,
        440
      ]
    }
