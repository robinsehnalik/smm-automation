{
  "name": "SMM-MSG-01 Community Triage Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smm/manychat-webhook",
        "options": {}
      },
      "id": "644efde2-114e-4c41-9bee-e0e250ecfdbc",
      "name": "ManyChat Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const headers = $input.item.json.headers || {};\nconst body = $input.item.json.body || {};\n\n// Webhook authentication via secret token\nconst providedSecret = headers['x-webhook-secret'] || body.secret || '';\nconst expectedSecret = $env.SMM_WEBHOOK_SECRET || 'test_secret_123';\n\nif (expectedSecret && providedSecret !== expectedSecret) {\n  throw new Error(\"Unauthorized webhook call: Invalid X-Webhook-Secret\");\n}\n\nconst subscriberId = String(body.subscriber_id || body.user_id || body.id || '');\nconst messageText = String(body.message_text || body.text || body.last_input_text || '').trim();\nconst channel = body.channel || 'instagram'; // instagram, facebook, whatsapp\nconst liveChatStatus = body.live_chat_status || 'closed'; // open = human active\n\nif (!subscriberId || !messageText) {\n  throw new Error(\"Malformed webhook payload: missing subscriber_id or message_text.\");\n}\n\nreturn {\n  json: {\n    subscriber_id: subscriberId,\n    message_text: messageText,\n    channel: channel,\n    live_chat_status: liveChatStatus,\n    external_message_id: body.message_id || ('msg_' + Date.now()),\n    started_at: Date.now()\n  }\n};"
      },
      "id": "0395087b-3b08-4a55-bd6e-c0fa0081fdd8",
      "name": "Verify Auth & Extract Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/social_conversations?subscriber_id=eq.{{ $json.subscriber_id }}&select=*",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        }
      },
      "id": "2a6ce5de-ff70-4d1a-9d0e-1819755a47df",
      "name": "Supabase: Check Conversation & Handoff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const event = $('Verify Auth & Extract Event').item.json;\nconst convRecords = $input.item.json;\nconst existingConv = Array.isArray(convRecords) && convRecords.length > 0 ? convRecords[0] : null;\n\n// 1. Check if human agent has taken over in ManyChat or Supabase\nconst isHumanTakeover = Boolean(\n  event.live_chat_status === 'open' || \n  (existingConv && existingConv.is_human_takeover) ||\n  (existingConv && existingConv.paused_until && new Date(existingConv.paused_until) > new Date())\n);\n\n// 2. Loop Protection & Spend Cap: max 5 automated replies per user session\nconst botReplyCount = existingConv ? (existingConv.bot_reply_count || 0) : 0;\nconst isRateLimited = botReplyCount >= 5;\n\nreturn {\n  json: {\n    ...event,\n    conversation_db_id: existingConv ? existingConv.id : null,\n    is_human_takeover: isHumanTakeover,\n    is_rate_limited: isRateLimited,\n    should_mute_bot: isHumanTakeover || isRateLimited,\n    bot_reply_count: botReplyCount\n  }\n};"
      },
      "id": "94abb311-a0d1-4821-b1e5-f6597ec3fcbd",
      "name": "Handoff & Loop Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.should_mute_bot }}",
              "value2": true
            }
          ]
        }
      },
      "id": "4454923f-d5d0-4efc-9455-d14d743c5477",
      "name": "Is Bot Muted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1160,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { status: 'bot_silenced', reason: 'Human agent active or rate limit exceeded' } };"
      },
      "id": "616e3d69-5eea-49eb-8227-2815dd03a6c7",
      "name": "Handoff Active: Bot Silenced",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        160
      ]
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"model\": \"gpt-4o\",\n  \"temperature\": 0.2,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are the Official Social Media Support Assistant.\\n\\nKNOWLEDGE & FAQ PLAYBOOK:\\n- BUSINESS HOURS: Mon-Fri 9:00 AM - 6:00 PM EST. Inquiries outside hours answered next business day.\\n- SHIPPING: 3-5 business days standard tracked shipping in US/EU. Tracking number emailed upon dispatch.\\n- RETURNS & REFUNDS: 30-day return policy for unopened items in original packaging.\\n- CATALOG: Full product collection and pricing available at company.com/shop.\\n- HUMAN SUPPORT: Support desk contact is support@company.com.\\n\\nSTRICT SAFETY & INTENT ALLOWLIST:\\nAuto-reply is permitted ONLY for these safe intents:\\n1. 'business_hours'\\n2. 'shipping_policy'\\n3. 'catalog_link'\\n4. 'returns_policy'\\n5. 'general_faq'\\n\\nSENSITIVE INTENTS (MUST ESCALATE - NEVER AUTO-REPLY):\\n- 'complaint' (angry customer, broken product, service outage)\\n- 'refund_dispute' (requests money back or transaction cancel)\\n- 'custom_pricing' (negotiation, wholesale request)\\n- 'legal_threat' or abusive language\\n\\nOUTPUT SCHEMA (strictly JSON):\\n{\\n  \\\"intent\\\": string,\\n  \\\"is_safe_to_reply\\\": boolean (true ONLY if intent is on the safe allowlist),\\n  \\\"reply_text\\\": string (short, polite, direct response if is_safe_to_reply is true; empty string otherwise),\\n  \\\"escalation_reason\\\": string (required if is_safe_to_reply is false)\\n}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Customer Message: <incoming_message>\" + $json.message_text + \"</incoming_message>\"\n    }\n  ]\n}"
      },
      "id": "c3fbb416-b180-496f-a97b-b6f899be626e",
      "name": "Grounded FAQ & Intent Classifier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1400,
        440
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prev = $('Handoff & Loop Guard').item.json;\nconst llmResp = $input.item.json;\n\nlet parsed = {\n  intent: 'unknown',\n  is_safe_to_reply: false,\n  reply_text: '',\n  escalation_reason: 'Unparseable response'\n};\n\ntry {\n  const content = llmResp.choices[0].message.content;\n  parsed = JSON.parse(content);\n} catch (e) {\n  parsed.escalation_reason = 'Failed to parse LLM JSON: ' + e.message;\n}\n\nreturn {\n  json: {\n    ...prev,\n    intent: parsed.intent || 'unknown',\n    is_safe_to_reply: Boolean(parsed.is_safe_to_reply && parsed.reply_text),\n    reply_text: parsed.reply_text || '',\n    escalation_reason: parsed.escalation_reason || '',\n    latency_ms: Date.now() - prev.started_at\n  }\n};"
      },
      "id": "8403b3cb-6793-401a-8108-c47c2adf7d58",
      "name": "Parse Intent & Route Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        440
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_safe_to_reply }}",
              "value2": true
            }
          ]
        }
      },
      "id": "8ac1e7ed-3829-4f0c-9372-ef8daa0a2449",
      "name": "Is Safe Auto-Reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1880,
        440
      ]
    },
    {
      "parameters": {
        "url": "https://api.manychat.com/fb/sending/sendContent",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.MANYCHAT_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"subscriber_id\": $json.subscriber_id,\n  \"data\": {\n    \"version\": \"v2\",\n    \"content\": {\n      \"messages\": [\n        {\n          \"type\": \"text\",\n          \"text\": $json.reply_text\n        }\n      ]\n    }\n  }\n}"
      },
      "id": "9cec96d2-bf5e-496a-af6f-942fa7164e2e",
      "name": "ManyChat: Send Message Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        2120,
