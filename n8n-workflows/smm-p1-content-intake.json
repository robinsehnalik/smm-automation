{
  "name": "SMM-P1 Content Intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smm/idea-intake",
        "responseMode": "responseNode"
      },
      "id": "3e4f90bd-adb6-4980-8bd1-21426e0120be",
      "name": "Content Idea Intake Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const body = $json.body || $json;\n\nconst topic = (body.topic || '').trim();\nconst keyMessage = (body.key_message || body.message || '').trim();\nconst targetPlatforms = body.target_platforms || ['linkedin', 'x', 'instagram'];\nconst targetDate = body.target_date || new Date(Date.now() + 24*3600*1000).toISOString();\n\nif (!topic || !keyMessage) {\n  throw new Error(\"Topic and Key Message are required for content intake.\");\n}\n\nreturn [{\n  json: {\n    topic,\n    keyMessage,\n    targetPlatforms,\n    targetDate,\n    mediaRefs: body.media_refs || []\n  }\n}];"
      },
      "id": "3c98e408-f94f-474b-9329-1bdb3c543056",
      "name": "Validate Content Idea",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/content_ideas",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  topic: $json.topic,\n  key_message: $json.keyMessage,\n  target_platforms: $json.targetPlatforms,\n  target_date: $json.targetDate,\n  media_refs: $json.mediaRefs,\n  status: 'idea'\n}) }}"
      },
      "id": "8e168ab9-e6d6-493c-8089-4d64dc13eb40",
      "name": "Insert Content Idea in DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/posts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  idea_id: $json[0].id,\n  approval_policy: 'approve'\n}) }}"
      },
      "id": "048ad441-2e39-43e0-b19f-fd81cc8ad7e5",
      "name": "Create Post Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_N8N_INSTANCE }}/webhook/smm/variants",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ postId: $json[0].id }) }}"
      },
      "id": "4fcfad15-2d9c-4de2-b76c-d3cdee26c2e3",
      "name": "Trigger SMM-P2 Variants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, ideaId: $('Insert Content Idea in DB').first().json[0].id }) }}"
      },
      "id": "38f1e815-fda4-4ac7-9e8f-21297bb157c9",
      "name": "Respond Intake OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1300,
        300
      ]
    }
  ],
