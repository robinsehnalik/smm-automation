{
  "name": "SMM-P2 LLM Platform Variants",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smm/variants",
        "responseMode": "onReceived"
      },
      "id": "e4c0a4da-3a7b-4634-bbcd-f4c64142d2c0",
      "name": "Variants Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/posts",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "eq.{{ $json.body.postId }}"
            },
            {
              "name": "select",
              "value": "*,content_ideas(*)"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        }
      },
      "id": "080e2300-d5f7-41e3-a65a-b60dda6edc73",
      "name": "Fetch Post & Idea",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"gpt-4o\",\n  response_format: { type: \"json_object\" },\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are an expert social media manager. Generate tailored copy for each requested platform adhering to norms (LinkedIn: professional, insightful; X: punchy, concise <= 280 chars; Instagram: engaging, visual caption + hashtags). Return JSON: { \\\"variants\\\": [ { \\\"platform\\\": \\\"linkedin|x|instagram|facebook\\\", \\\"body\\\": string, \\\"hashtags\\\": [string] } ] }\"\n    },\n    {\n      role: \"user\",\n      content: `Topic: ${$json[0].content_ideas.topic}\\nKey Message: ${$json[0].content_ideas.key_message}\\nTarget Platforms: ${JSON.stringify($json[0].content_ideas.target_platforms)}`\n    }\n  ]\n}) }}"
      },
      "id": "3f80a7f0-cec5-409d-a285-696cec2e833d",
      "name": "LLM Platform Variant Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const res = JSON.parse($json.choices[0].message.content);\nconst postId = $('Fetch Post & Idea').first().json[0].id;\nconst targetDate = $('Fetch Post & Idea').first().json[0].content_ideas.target_date;\n\nconst variants = (res.variants || []).map(v => ({\n  post_id: postId,\n  platform: v.platform,\n  body: v.body,\n  publish_at: targetDate,\n  status: 'pending_approval'\n}));\n\nreturn variants.map(v => ({ json: v }));"
      },
      "id": "575910ca-c4ca-4048-998d-05b95184dbbd",
      "name": "Save Platform Variants in DB",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/post_variants",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "5f121a77-0c6d-4b10-a68e-224aa534aa19",
      "name": "Insert Variants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.RESEND_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  from: $env.SYSTEM_SENDER_EMAIL || \"social@yourdomain.com\",\n  to: [$env.OWNER_NOTIFICATION_EMAIL],\n  subject: \"Social Post Variants Ready for Approval\",\n  html: `<p>New variants generated for topic: <strong>${$('Fetch Post & Idea').first().json[0].content_ideas.topic}</strong>.</p>\n<p><a href=\\\"${$env.LINK_TO_YOUR_DASHBOARD || 'https://dashboard.yourdomain.com'}/smm\\\">Review and Schedule Posts</a></p>`\n}) }}"
      },
      "id": "f710599b-7dc4-49cb-9b4f-7d778d7718cd",
      "name": "Alert Owner Variants Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1300,
        300
      ]
    }
  ],
