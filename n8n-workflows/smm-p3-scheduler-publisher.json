{
  "name": "SMM-P3 Scheduler & Publisher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "* * * * *"
            }
          ]
        }
      },
      "id": "a7f2d961-2aaf-4851-97eb-56bcfd2e8041",
      "name": "Every Minute Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/post_variants",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "eq.scheduled"
            },
            {
              "name": "publish_at",
              "value": "lte.now()"
            },
            {
              "name": "select",
              "value": "*"
            },
            {
              "name": "limit",
              "value": "5"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        }
      },
      "id": "709cc243-55a3-4f48-9679-d67e7cacfb82",
      "name": "Fetch Due Scheduled Variants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const items = Array.isArray($json) ? $json : ($json.id ? [$json] : []);\nreturn items.map(i => ({ json: i }));"
      },
      "id": "d3231d9e-86ce-4352-bb38-cb10038d97cb",
      "name": "Split Due Variants",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/post_variants",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "eq.{{ $json.id }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'publishing' }) }}"
      },
      "id": "53c35747-acc3-45f1-a07c-890901238220",
      "name": "Lock Variant Publishing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        820,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_SCHEDULER_API || 'https://app.ayrshare.com/api/post' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SCHEDULER_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  post: $('Split Due Variants').first().json.body,\n  platforms: [$('Split Due Variants').first().json.platform],\n  mediaUrls: $('Split Due Variants').first().json.media_refs || []\n}) }}"
      },
      "id": "a28d0e6a-2c8b-4d64-bcab-269da36dae96",
      "name": "Publish via 3rd-Party Scheduler API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/post_variants",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "eq.{{ $('Split Due Variants').first().json.id }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  status: 'published',\n  platform_post_id: ($json.id || $json.postIds?.[0]?.id || 'SCHED-' + Date.now()).toString()\n}) }}"
      },
      "id": "be58a8ea-3722-4a2d-8f85-a5444658ce91",
      "name": "Update Variant Published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1300,
        300
      ]
    }
  ],
