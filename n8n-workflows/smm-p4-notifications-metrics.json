{
  "name": "SMM-P4 Notifications & Metrics",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 18 * * *"
            }
          ]
        }
      },
      "id": "1d2cb129-3607-4101-aa3a-edcc2194b13a",
      "name": "Daily Metrics Poll Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/post_variants",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "eq.published"
            },
            {
              "name": "select",
              "value": "id,platform,platform_post_id"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        }
      },
      "id": "41521250-8cc1-4dd6-b0de-f6268ae4b5ea",
      "name": "Fetch Published Variants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/post_metrics",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  variant_id: $json[0]?.id || 'mock',\n  impressions: 250,\n  likes: 18,\n  comments: 3,\n  shares: 2\n}) }}"
      },
      "id": "a51f23d4-029f-4583-b52f-5dba001adfaf",
      "name": "Save Metrics Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        580,
        300
      ]
    }
  ],
  "connections": {
    "Daily Metrics Poll Trigger": {
      "main": [
        [
          {
            "node": "Fetch Published Variants",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Published Variants": {
      "main": [
        [
          {
            "node": "Save Metrics Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "5384d97c-0959-435e-8c8a-512b21e08538",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "automation-suite"
  },
  "id": "e060d8cd",
  "tags": []
}