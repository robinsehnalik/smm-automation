{
  "name": "SMM-POST-02 Approval Dispatcher",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "smm/dispatch-approved-post",
        "options": {}
      },
      "id": "f1d7b4ca-bafa-4e9f-851a-12f0b81c8ad8",
      "name": "Webhook / Approval Event Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst body = item.body || item;\n\nconst postId = body.id || body.post_id;\nconst variants = body.variants || {};\nconst mediaUrls = body.media_urls || [];\nconst targetPlatforms = body.target_platforms || ['linkedin', 'twitter', 'instagram'];\nconst scheduledFor = body.scheduled_for;\n\nif (!postId) {\n  throw new Error(\"Missing post 'id' in approval event.\");\n}\n\n// Ayrshare multi-platform post format\nconst ayrsharePayload = {\n  post: variants.linkedin || variants.twitter || variants.instagram || '',\n  platforms: targetPlatforms,\n  mediaUrls: mediaUrls.length > 0 ? mediaUrls : undefined,\n  postType: mediaUrls.length > 0 ? 'image' : 'text'\n};\n\n// Use platform-specific text overrides in Ayrshare\nif (variants.twitter || variants.instagram || variants.linkedin) {\n  ayrsharePayload.platforms = targetPlatforms;\n  // If specific overrides provided:\n  if (variants.twitter) ayrsharePayload.twitter = variants.twitter;\n  if (variants.instagram) ayrsharePayload.instagram = variants.instagram;\n  if (variants.linkedin) ayrsharePayload.linkedin = variants.linkedin;\n}\n\n// Add scheduleDate if set\nif (scheduledFor) {\n  ayrsharePayload.scheduleDate = new Date(scheduledFor).toISOString();\n}\n\nreturn {\n  json: {\n    post_id: postId,\n    ayrshare_payload: ayrsharePayload,\n    scheduled_for: scheduledFor || 'immediate'\n  }\n};"
      },
      "id": "8cb59804-5dc7-45f7-adb8-f61a93e0e846",
      "name": "Format Ayrshare Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://app.ayrshare.com/api/post",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.AYRSHARE_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={{ $json.ayrshare_payload }}"
      },
      "id": "3efa108b-8916-4779-8667-af1907373dcc",
      "name": "Call Ayrshare API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.LINK_TO_YOUR_SUPABASE_URL }}/rest/v1/social_posts?id=eq.{{ $('Format Ayrshare Payload').item.json.post_id }}",
        "method": "PATCH",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"scheduler_post_id\": $json.id || $json.refId || 'ayr_' + Date.now(),\n  \"status\": $json.status === 'scheduled' || $('Format Ayrshare Payload').item.json.scheduled_for !== 'immediate' ? 'scheduled' : 'published',\n  \"updated_at\": new Date().toISOString()\n}"
      },
      "id": "fded1cc2-1853-4533-98f7-9bef99256898",
      "name": "Update Supabase Post Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        920,
        300
      ]
    }
  ],
  "connections": {
    "Webhook / Approval Event Trigger": {
      "main": [
        [
          {
            "node": "Format Ayrshare Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Ayrshare Payload": {
      "main": [
        [
          {
            "node": "Call Ayrshare API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Ayrshare API": {
      "main": [
        [
          {
            "node": "Update Supabase Post Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
